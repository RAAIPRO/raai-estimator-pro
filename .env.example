# AI-Сметчик PRO — опциональные переменные окружения
#
# Без этого файла работают все 10 режимов (только на промпте — нет внешних вызовов).
# Заполните только если хотите интеграции с внешними системами.
#
# Как использовать:
# cp .env.example .env
# # откройте .env и заполните нужные ключи
#
# Удалите или закомментируйте неиспользуемые строки. # ═══════════════════════════════════════════════════
# LLM — модель (если запускаете вне Claude/OpenClaw)
# ═══════════════════════════════════════════════════ ANTHROPIC_API_KEY="" # если запускаете через Anthropic SDK
OPENAI_API_KEY="" # если через OpenAI-совместимый API
DEEPSEEK_API_KEY="" # если прямо DeepSeek # ═══════════════════════════════════════════════════
# Google Sheets — выгрузка смет и объёмных ведомостей
# ═══════════════════════════════════════════════════
# Где брать: https://console.cloud.google.com/ → Service Account → JSON key
# Гайд: docs/onboarding.md раздел "Google Sheets" GOOGLE_SHEETS_CREDENTIALS_JSON="" # путь к JSON-ключу сервис-аккаунта
GOOGLE_SHEETS_SPREADSHEET_ID="" # ID таблицы (из URL)
GOOGLE_SHEETS_TAB_ESTIMATES="Сметы" # вкладка с реестром смет
GOOGLE_SHEETS_TAB_MATERIALS="Материалы" # вкладка с расчётом материалов # ═══════════════════════════════════════════════════
# Telegram — отправка готовой сметы / алерты по бюджету
# ═══════════════════════════════════════════════════
# Где брать бот-токен: @BotFather в Telegram → /newbot
# Где брать chat_id: @userinfobot → переслать боту любое сообщение TELEGRAM_BOT_TOKEN="" # токен вашего бота
TELEGRAM_CHAT_ID="" # ваш chat_id # ═══════════════════════════════════════════════════
# Grand-Смета / РИК — экспорт в профессиональный формат
# ═══════════════════════════════════════════════════
# 🟡 Гипотеза: прямой API у Гранд-Сметы и РИК на 04.2026 не подтверждён.
# Используйте ручной экспорт XML/Excel из сгенерированного AI-Сметчиком расчёта. GRAND_SMETA_EXPORT_PATH="" # папка для сохранения XML-экспортов (если настроен)
RIK_EXPORT_PATH="" # папка для совместимых файлов РИК # ═══════════════════════════════════════════════════
# Web Search — для проверки текущих цен на материалы
# ═══════════════════════════════════════════════════ EXA_API_KEY="" # Exa.ai для поиска актуальных цен (опционально)
TAVILY_API_KEY="" # Tavily (альтернатива) # ═══════════════════════════════════════════════════
# Базы цен онлайн (опционально)
# ═══════════════════════════════════════════════════
# 🟡 Гипотеза: прямой API к ФЕР/ТЕР базам Минстроя на 04.2026 не подтверждён.
# Для ручного обновления индексов — сайт minstroi.gov.ru → Ценообразование. FER_TER_BASE_URL="" # если у вашей компании есть подписка на базу расценок
MINSTROI_INDEX_SOURCE="https://minstroi.gov.ru" # источник актуальных индексов пересчёта
